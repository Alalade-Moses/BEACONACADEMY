{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://beaconbridge-server-production.up.railway.app/api/:match*"
    },
    {
      "source": "/uploads/:match*",
      "destination": "https://beaconbridge-server-production.up.railway.app/uploads/:match*"
    },
    {
      "source": "/slides/:match*",
      "destination": "https://beaconbridge-server-production.up.railway.app/slides/:match*"
    },
    {
      "source": "/about",
      "destination": "/about/index.html"
    },
    {
      "source": "/curriculum",
      "destination": "/curriculum/index.html"
    },
    {
      "source": "/how-it-works",
      "destination": "/how-it-works/index.html"
    },
    {
      "source": "/contact",
      "destination": "/contact/index.html"
    },
    {
      "source": "/book-consultation",
      "destination": "/book-consultation/index.html"
    },
    {
      "source": "/consultation",
      "destination": "/consultation/index.html"
    },
    {
      "source": "/blog",
      "destination": "/blog/index.html"
    },
    {
      "source": "/faq",
      "destination": "/faq/index.html"
    },
    {
      "source": "/apply-to-teach",
      "destination": "/apply-to-teach/index.html"
    },
    {
      "source": "/tutor/apply",
      "destination": "/tutor/apply/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy/index.html"
    },
    {
      "source": "/terms",
      "destination": "/terms/index.html"
    },
    {
      "source": "/security",
      "destination": "/security/index.html"
    },
    {
      "source": "/ielts-registration",
      "destination": "/ielts-registration/index.html"
    },
    {
      "source": "/register/ielts",
      "destination": "/ielts-registration/index.html"
    },
    {
      "source": "/register",
      "destination": "/register/index.html"
    },
    {
      "source": "/payment-proof",
      "destination": "/payment-proof/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self \"https://*.daily.co\"), microphone=(self \"https://*.daily.co\"), display-capture=(self \"https://*.daily.co\"), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://unpkg.com https://*.daily.co; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://beaconbridge-server-production.up.railway.app https://images.unsplash.com https://api.dicebear.com https:; media-src 'self' blob: data: https://beaconbridge-server-production.up.railway.app https://commondatastorage.googleapis.com https:; connect-src 'self' https://beaconbridge-server-production.up.railway.app wss://beaconbridge-server-production.up.railway.app https://*.daily.co wss://*.daily.co https://*.twilio.com wss://*.twilio.com; frame-src 'self' https://*.daily.co https://www.youtube.com https://player.vimeo.com https://www.loom.com https://drive.google.com https://beaconbridge-server-production.up.railway.app blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'self';"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(hero|pages|classrooms)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.(?:jpg|jpeg|png|webp|svg|ico))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
