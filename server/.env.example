PORT=5000
NODE_ENV=production
JWT_SECRET=your_production_jwt_secret_key_here
CLIENT_URL=https://beaconbridgeacademics.co.uk
PRODUCTION_CLIENT_URL=https://beaconbridgeacademics.co.uk
SUPPORT_EMAIL=info@beaconbridgeacademics.co.uk
ADMISSIONS_EMAIL=admissions@beaconbridgeacademics.co.uk
ADMIN_EMAIL=admin@beaconbridgeacademics.co.uk

# Hostinger SMTP Email Configuration
# 1. Login to Hostinger hPanel -> Emails -> Manage beaconbridgeacademics.co.uk
# 2. Host: smtp.hostinger.com (Port: 465 SSL or 587 TLS)
# 3. User: info@beaconbridgeacademics.co.uk
# 4. Pass: Your Hostinger email account password
EMAIL_DOMAIN=beaconbridgeacademics.co.uk
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@beaconbridgeacademics.co.uk
SMTP_PASS=your_hostinger_email_password_here

# Supabase Credentials (from Supabase Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Optional SMTP Email Configuration (SendGrid, Postmark, or SMTP)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@beaconbridgeacademics.co.uk
SMTP_PASS=your-hostinger-email-password
