{
  "name": "beaconbridge-academics-platform",
  "version": "1.0.0",
  "description": "Beacon Bridge Academics — UK & International Virtual Classroom & LMS Platform",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "start": "concurrently \"npm run start --workspace=server\" \"npm run dev --workspace=client\"",
    "start:server": "node server/index.js",
    "build:client": "npm run build --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "db:init": "npm run db:init --workspace=server",
    "build": "npm run build --workspace=client",
    "install:all": "npm install && npm install --workspace=server && npm install --workspace=client"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
